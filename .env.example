# ============================================================
#  BRAVON WEB APP — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================

# ── SUPABASE DATABASE (PRODUCTION DATABASE) ──────────────────
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── STRIPE (PAYMENTS & CHECKOUT) ────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
# Test keys for staging: sk_test_... and pk_test_...
# Live keys for production: sk_live_... and pk_live_...
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Webhook Secret — from Stripe Dashboard > Webhooks
# Local listen: stripe listen --forward-to localhost:3000/api/webhook/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# ── APP BASE URL ─────────────────────────────────────────────
# Local dev: http://localhost:3000
# Production: https://bravoncity.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── ADMIN SECURITY ───────────────────────────────────────────
# Set a strong random string (at least 32 characters) for signing session cookies
ADMIN_SESSION_SECRET=change-this-to-a-secure-random-32-char-secret-key-12345
ADMIN_PASSWORD=change-to-a-strong-admin-password

